NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/offerbridge

JWT_SECRET=replace-with-a-long-random-secret
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────
# Razorpay — get keys from https://dashboard.razorpay.com/app/keys
#   Test mode:  rzp_test_*  (safe for development, no real money)
#   Live mode:  rzp_live_*  (only for production after activation)
# ──────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_TPLQwxroo3iHDe
RAZORPAY_KEY_SECRET=xqSen7cBc5o4MBquXyyVmJ9M

# Razorpay Dashboard → Webhooks → Create → copy the webhook secret
RAZORPAY_WEBHOOK_SECRET=Offer_Bridges

# IMPORTANT: This key is sent to the browser (public). Must match RAZORPAY_KEY_ID exactly.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_TPLQwxroo3iHDe
